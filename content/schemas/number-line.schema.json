{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathjourney.app/content/schemas/number-line.schema.json",
  "title": "number-line",
  "description": "Activity kind number-line: drag a point to a value; drops snap to the grid min + k * step (AD-3).",
  "x-equivalence": "ordered",
  "$defs": {
    "payload": {
      "type": "object",
      "required": ["prompt", "min", "max", "step", "target"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "target": {
          "type": "string",
          "description": "The problem's exact value, e.g. \"3/4\", \"-1/2\" or \"1.25\"",
          "pattern": "^-?\\d+(\\.\\d+)?(/\\d+)?$"
        }
      }
    },
    "answer": {
      "type": "number",
      "description": "The value of the grid tick the point must land on"
    }
  }
}
