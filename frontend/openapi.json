            "type" : "string"
          },
          "kind" : {
            "type" : "string"
          },
          "payload" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "Opaque kind-specific payload; typed only by the content schemas (AD-7)"
          },
          "answer" : {
            "description" : "Opaque canonical answer, any JSON value (AD-3)"
          }
        },
        "required" : [ "answer", "id", "kind", "payload" ]
      },
      "ConceptResponse" : {
        "type" : "object",
        "description" : "A concept and its items",
        "properties" : {
          "id" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
